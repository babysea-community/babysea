{
  "name": "babysea",
  "version": "1.4.6",
  "description": "Production TypeScript SDK for the BabySea execution control plane for generative media. One API, one schema, one lifecycle across image and video inference providers.",
  "keywords": [
    "babysea",
    "open-source",
    "ai-infrastructure",
    "control-plane",
    "execution-layer",
    "inference-providers",
    "developer-tools",
    "creative-tools",
    "generative-ai",
    "generative-media"
  ],
  "homepage": "https://docs.babysea.ai",
  "bugs": {
    "url": "https://github.com/babysea-community/babysea/issues"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "BabySea",
    "url": "https://babysea.ai"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/babysea-community/babysea.git"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./webhooks": {
      "import": {
        "types": "./dist/webhooks.d.ts",
        "default": "./dist/webhooks.js"
      },
      "require": {
        "types": "./dist/webhooks.d.cts",
        "default": "./dist/webhooks.cjs"
      }
    }
  },
  "files": [
    "dist",
    "docs",
    "examples",
    "CHANGELOG.md",
    "CODE_OF_CONDUCT.md",
    "CONTRIBUTING.md",
    "README.md",
    "SECURITY.md",
    "LICENSE",
    "socket.json"
  ],
  "sideEffects": false,
  "dependencies": {
    "zod": "3.25.76"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "version:generate": "node scripts/generate-version.mjs",
    "prebuild": "node scripts/generate-version.mjs",
    "build": "tsup",
    "clean": "rm -rf .turbo node_modules dist",
    "format": "prettier --check \"**/*.{mjs,ts,md,json}\"",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "npm run build && node --test \"test/*.mjs\"",
    "test:coverage": "npm run build && mkdir -p coverage && node --enable-source-maps --test --experimental-test-coverage --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info \"test/*.mjs\"",
    "typecheck": "tsc --noEmit",
    "typecheck:examples": "tsc --noEmit -p examples/tsconfig.json",
    "exports:check": "npm run build && node --test test/exports.test.mjs",
    "pack:dry-run": "npm pack --dry-run",
    "audit:prod": "npm audit --omit=dev",
    "sentry:check": "node scripts/sentry-project-check.mjs",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run typecheck:examples && pnpm run test:coverage && pnpm run format",
    "prepublishOnly": "npm run check && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.0.1",
    "prettier": "^3.8.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.55.0"
  },
  "prettier": {
    "arrowParens": "always",
    "printWidth": 80,
    "semi": true,
    "singleQuote": true,
    "tabWidth": 2,
    "useTabs": false
  }
}
